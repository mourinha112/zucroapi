// ============================================
// CHARGEBACKS E SELLERS DE RISCO
// ============================================

model Chargeback {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id      String    @db.Uuid
  user_id         String    @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  reason          String?
  status          String    @default("open") @db.VarChar(20) // open, won, lost, cancelled
  external_id     String?   @db.VarChar(100) // ID do chargeback no gateway
  opened_at       DateTime  @default(now()) @db.Timestamptz
  resolved_at     DateTime? @db.Timestamptz
  resolved_by     String?   @db.Uuid
  admin_notes     String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("chargebacks")
}

model RiskySellerLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  action          String   @db.VarChar(50) // marked_risky, unmarked_risky, blocked, unblocked
  reason          String?
  chargebacks     Int      @default(0)
  refunds         Int      @default(0)
  total_disputed  Decimal  @default(0) @db.Decimal(10, 2)
  marked_by       String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("risky_seller_logs")
}

// ============================================
// ORDERBUMP - Ofertas adicionais no checkout
// ============================================

model OrderBump {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  product_id        String    @db.Uuid // Produto principal (checkout)
  bump_product_id   String    @db.Uuid // Produto que será oferecido como orderbump
  name              String    @db.VarChar(200) // Nome da oferta (ex: "Levar por R$19,90")
  description       String?   // Descrição breve da oferta
  price             Decimal   @db.Decimal(10, 2) // Preço especial do orderbump
  original_price    Decimal?  @db.Decimal(10, 2) // Preço original (para mostrar desconto)
  discount_type     String    @default("percentage") @db.VarChar(20) // percentage, fixed
  discount_value    Decimal   @default(0) @db.Decimal(10, 2)
  show_in_checkout  Boolean   @default(true)
  show_image        Boolean   @default(true)
  position         Int       @default(0) // Posição de exibição (0 = antes do produto, 1+ = depois)
  min_quantity     Int       @default(1) // Quantidade mínima para ativar
  active           Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product        Product   @relation("OrderBumpMainProduct", fields: [product_id], references: [id], onDelete: Cascade)
  bump_product   Product   @relation("OrderBumpOfferProduct", fields: [bump_product_id], references: [id], onDelete: Cascade)

  @@map("order_bumps")
}

// ============================================
// SUBSCRIPTION PLANS - Planos de assinatura
// ============================================

model SubscriptionPlan {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  name              String    @db.VarChar(200)
  description       String?
  interval          String    @default("month") @db.VarChar(20) // week, month, year
  interval_count    Int       @default(1) // A cada X intervalos (ex: a cada 2 meses)
  price             Decimal   @db.Decimal(10, 2)
  trial_days        Int       @default(0) // Dias de teste gratuito
  max_installments  Int       @default(1) // Parcelamento da primeira cobrança
  cancel_at_end     Boolean   @default(true) // Cancela ao final do período se não houver pagamento
  active            Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ============================================
// SUBSCRIPTIONS - Assinaturas ativas
// ============================================

model Subscription {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid // Vendedor (owner da assinatura)
  customer_id           String?   @db.Uuid // Cliente (se tiver cadastro)
  customer_email        String    @db.VarChar(200)
  customer_name         String?   @db.VarChar(200)
  customer_document     String?   @db.VarChar(20)
  subscription_plan_id  String    @db.Uuid
  external_subscription_id String? @db.VarChar(100) // ID da assinatura no gateway (EfiBank/Asaas)
  status                String    @default("active") @db.VarChar(20) // active, paused, cancelled, past_due
  current_period_start  DateTime  @db.Timestamptz
  current_period_end   DateTime  @db.Timestamptz
  next_billing_date    DateTime  @db.Timestamptz
  cancel_at_period_end  Boolean   @default(false)
  cancelled_at         DateTime? @db.Timestamptz
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @db.Timestamptz

  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  customer         User?             @relation("CustomerSubscriptions", fields: [customer_id], references: [id])
  plan             SubscriptionPlan  @relation(fields: [subscription_plan_id], references: [id])
  subscription_subscriptions SubscriptionPayment[]
  payments         Payment[]         @relation("PaymentSubscription")

  @@map("subscriptions")
}

// ============================================
// SUBSCRIPTION PAYMENTS - Cobranças das assinaturas
// ============================================

// ============================================
// TICKETS - Sistema de Suporte
// ============================================

model Ticket {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  subject         String    @db.VarChar(200)
  category        String    @default("support") @db.VarChar(50) // support, billing, technical, bug, other
  priority        String    @default("normal") @db.VarChar(20) // low, normal, high, urgent
  status          String    @default("open") @db.VarChar(20) // open, in_progress, resolved, closed
  description     String
  admin_id        String?   @db.Uuid
  resolved_at     DateTime? @db.Timestamptz
  closed_at       DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String   @db.Uuid
  user_id    String?  @db.Uuid
  admin_id   String?  @db.Uuid
  message    String
  is_admin   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id])

  @@map("ticket_messages")
}

// ============================================
// LOGIN CODES (2FA por email)
// ============================================

model LoginCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  code       String   @db.VarChar(6)
  expires_at DateTime @db.Timestamptz
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("login_codes")
}

// ============================================
// APP INTEGRATIONS (Aplicativos externos)
// ============================================

model AppIntegration {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  app_id     String   @db.VarChar(50) // utmify, etc.
  api_token  String   @db.VarChar(500)
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, app_id])
  @@map("app_integrations")
}

// ============================================
// CUPONS DE DESCONTO
// ============================================

model Coupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  code            String    @db.VarChar(50)
  discount_type   String    @default("percentage") @db.VarChar(20) // percentage, fixed
  discount_value  Decimal   @db.Decimal(10, 2)
  max_uses        Int?      // null = ilimitado
  used_count      Int       @default(0)
  min_value       Decimal?  @db.Decimal(10, 2) // valor mínimo do pedido
  max_discount    Decimal?  @db.Decimal(10, 2) // teto do desconto (p/ percentual)
  product_id      String?   @db.Uuid // null = todos os produtos
  starts_at       DateTime? @db.Timestamptz
  expires_at      DateTime? @db.Timestamptz
  active          Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id])

  @@unique([user_id, code])
  @@map("coupons")
}

model SubscriptionPayment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id       String    @db.Uuid
  payment_id            String?   @db.Uuid // Pagamento criado (se houver)
  external_payment_id   String?   @db.VarChar(100) // ID da cobrança no gateway
  amount                Decimal   @db.Decimal(10, 2)
  status                String    @default("pending") @db.VarChar(20) // pending, paid, failed, cancelled
  billing_date          DateTime  @db.Timestamptz
  paid_at              DateTime? @db.Timestamptz
  failure_reason       String?   @db.VarChar(500)
  created_at           DateTime  @default(now()) @db.Timestamptz

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [payment_id], references: [id])

  @@map("subscription_payments")
}
