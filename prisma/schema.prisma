generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String    @db.VarChar(200)
  email                     String    @unique @db.VarChar(200)
  password_hash             String    @db.VarChar(255)
  person_type               String    @default("PF") @db.VarChar(2) // PF = Pessoa Física, PJ = Pessoa Jurídica
  cpf_cnpj                  String?   @db.VarChar(20)
  phone                     String?   @db.VarChar(20)
  avatar                    String?
  asaas_customer_id         String?   @db.VarChar(100)
  asaas_api_key             String?
  balance                   Decimal   @default(0) @db.Decimal(10, 2)
  reserved_balance          Decimal   @default(0) @db.Decimal(10, 2)
  account_status            String    @default("pending") @db.VarChar(20)
  account_status_reason     String?
  account_reviewed_by       String?   @db.Uuid
  account_reviewed_at       DateTime? @db.Timestamptz
  identity_verified         Boolean   @default(false)
  efi_customer_id           String?   @db.VarChar(100)
  payment_provider          String    @default("eusouzucropay") @db.VarChar(20) // eusouzucropay (default), efibank, asaas, enki
  verification_status       String    @default("pending") @db.VarChar(20)
  verification_submitted_at DateTime? @db.Timestamptz
  verification_reviewed_at  DateTime? @db.Timestamptz
  verification_reviewed_by  String?   @db.Uuid
  verification_rejection_reason String?
  verification_attempts         Int       @default(0) // Contador de tentativas de verificação (máx 3)
  // Campos de risco
  chargeback_count          Int       @default(0)
  refund_count              Int       @default(0)
  is_risky                  Boolean   @default(false)
  risk_level                String    @default("low") @db.VarChar(20) // low, medium, high
  risk_notes                String?
  blocked_at                DateTime? @db.Timestamptz
  blocked_by                String?   @db.Uuid
  blocked_reason            String?
  notification_preferences  Json      @default("{\"sale_approved\":true,\"sale_pending\":true,\"withdrawal_approved\":true}") // Preferências de notificação push
  created_at                DateTime  @default(now()) @db.Timestamptz
  updated_at                DateTime  @default(now()) @db.Timestamptz

  // Relations
  products           Product[]
  payments           Payment[]
  payment_links      PaymentLink[]
  transactions       Transaction[]
  withdrawals        Withdrawal[]
  api_keys           ApiKey[]
  webhooks           Webhook[]
  push_subscriptions PushSubscription[]
  balance_reserves   BalanceReserve[]
  chargebacks        Chargeback[]
  risky_seller_logs  RiskySellerLog[]
  user_verification  UserVerification?
  custom_rates       UserCustomRate[]
  order_bumps        OrderBump[]
  subscription_plans SubscriptionPlan[]
  subscriptions      Subscription[] // Assinaturas criadas pelo usuário (vendedor)
  customer_subscriptions Subscription[] @relation("CustomerSubscriptions") // Assinaturas onde o usuário é cliente
  tickets                Ticket[]
  ticket_messages        TicketMessage[]
  coupons                Coupon[]
  app_integrations       AppIntegration[]
  login_codes            LoginCode[]
  received_splits        PaymentSplit[]      @relation("SplitRecipient")
  product_split_rules    ProductSplitRule[]  @relation("SplitRuleRecipient")

  @@map("users")
}

model AdminCredential {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(200)
  password_hash String    @db.VarChar(255)
  name          String?   @default("Administrador") @db.VarChar(200)
  role          String    @default("admin") @db.VarChar(50)
  is_active     Boolean   @default(true)
  last_login    DateTime? @db.Timestamptz
  permissions   Json      @default("[]")
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz

  @@map("admin_credentials")
}

model Product {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid
  name                  String    @db.VarChar(200)
  description           String?
  subtitle              String?   @db.VarChar(200)
  price                 Decimal   @db.Decimal(10, 2)
  image_url             String?
  cover_url             String?
  cover_video_url       String?   // Banner em vídeo da área de membros (URL YouTube/Vimeo/mp4)
  stock                 Int?
  active                Boolean   @default(true)
  marketplace_enabled   Boolean   @default(false)
  commission_percentage Decimal   @default(30) @db.Decimal(5, 2)
  fee_payer             String    @default("seller") @db.VarChar(10)
  is_subscription       Boolean   @default(false)
  subscription_plan_id  String?   @db.Uuid
  product_type          String    @default("link") @db.VarChar(20) // 'link' | 'infoproduct'
  member_area_enabled   Boolean   @default(false)
  support_email         String?   @db.VarChar(180)
  welcome_message       String?
  slug                  String?   @unique @db.VarChar(120)
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @default(now()) @db.Timestamptz

  user                   User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_links          PaymentLink[]
  checkout_customization CheckoutCustomization?
  order_bumps            OrderBump[]             @relation("OrderBumpMainProduct")
  offer_order_bumps      OrderBump[]             @relation("OrderBumpOfferProduct")
  coupons                Coupon[]
  split_rules            ProductSplitRule[]
  modules                ProductModule[]
  classes                ProductClass[]
  groups                 ProductGroup[]
  pixels                 ProductTrackingPixel[]
  waitlist               ProductWaitlist[]
  member_accesses        ProductMemberAccess[]

  @@map("products")
}

model ProductModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String   @db.Uuid
  title       String   @db.VarChar(200)
  description String?
  cover_url   String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  lessons ProductLesson[]

  @@index([product_id])
  @@index([product_id, position])
  @@map("product_modules")
}

model ProductLesson {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id        String   @db.Uuid
  title            String   @db.VarChar(200)
  description      String?
  video_provider   String?  @db.VarChar(20)
  video_url        String?
  duration_seconds Int?
  position         Int      @default(0)
  is_free          Boolean  @default(false)
  active           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  module    ProductModule           @relation(fields: [module_id], references: [id], onDelete: Cascade)
  materials ProductLessonMaterial[]
  progress  ProductLessonProgress[]
  comments  LessonComment[]
  ratings   LessonRating[]

  @@index([module_id])
  @@index([module_id, position])
  @@map("product_lessons")
}

model ProductGroup {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  name       String   @db.VarChar(200)
  type       String   @default("whatsapp") @db.VarChar(20) // whatsapp, telegram, discord, other
  url        String
  position   Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_groups")
}

model LessonComment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id    String    @db.Uuid
  product_id   String    @db.Uuid
  access_id    String?   @db.Uuid // membro (comprador) que comentou
  author_name  String    @db.VarChar(200)
  author_email String?   @db.VarChar(200)
  is_admin     Boolean   @default(false) // resposta do produtor
  message      String
  parent_id    String?   @db.Uuid // resposta a outro comentário
  created_at   DateTime  @default(now()) @db.Timestamptz

  lesson ProductLesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@index([parent_id])
  @@map("lesson_comments")
}

model LessonRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id  String   @db.Uuid
  access_id  String   @db.Uuid
  rating     Int // 1 a 5
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  lesson ProductLesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([lesson_id, access_id])
  @@index([lesson_id])
  @@map("lesson_ratings")
}

model ProductLessonMaterial {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id  String   @db.Uuid
  name       String   @db.VarChar(200)
  type       String   @default("file") @db.VarChar(20)
  file_url   String
  size_bytes BigInt?
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz

  lesson ProductLesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@map("product_lesson_materials")
}

model ProductClass {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String    @db.Uuid
  name        String    @db.VarChar(200)
  description String?
  start_date  DateTime? @db.Timestamptz
  end_date    DateTime? @db.Timestamptz
  max_seats   Int?
  active      Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz

  product  Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  accesses ProductMemberAccess[]

  @@index([product_id])
  @@map("product_classes")
}

model ProductTrackingPixel {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @db.Uuid
  platform     String   @db.VarChar(30)
  pixel_id     String?  @db.VarChar(120)
  access_token String?
  events       Json?
  active       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_tracking_pixels")
}

model ProductWaitlist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  name       String   @db.VarChar(200)
  email      String   @db.VarChar(200)
  phone      String?  @db.VarChar(40)
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, email])
  @@index([product_id])
  @@map("product_waitlist")
}

model ProductMemberAccess {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String    @db.Uuid
  payment_id     String?   @db.Uuid
  buyer_email    String    @db.VarChar(200)
  buyer_name     String?   @db.VarChar(200)
  buyer_phone    String?   @db.VarChar(40)
  access_token   String    @unique @db.VarChar(80)
  class_id       String?   @db.Uuid
  active         Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz
  last_access_at DateTime? @db.Timestamptz

  product  Product                 @relation(fields: [product_id], references: [id], onDelete: Cascade)
  class    ProductClass?           @relation(fields: [class_id], references: [id], onDelete: SetNull)
  progress ProductLessonProgress[]

  @@index([product_id])
  @@index([buyer_email])
  @@map("product_member_access")
}

model ProductLessonProgress {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  access_id        String    @db.Uuid
  lesson_id        String    @db.Uuid
  completed        Boolean   @default(false)
  watched_seconds  Int       @default(0)
  completed_at     DateTime? @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  access ProductMemberAccess @relation(fields: [access_id], references: [id], onDelete: Cascade)
  lesson ProductLesson       @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([access_id, lesson_id])
  @@map("product_lesson_progress")
}

model CheckoutCustomization {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String    @unique @db.Uuid
  
  // Imagens
  logo_url            String?
  banner_url          String?
  background_url      String?
  
  // Cores
  primary_color       String    @default("#5818C8") @db.VarChar(20)
  secondary_color     String    @default("#7B2FF7") @db.VarChar(20)
  background_color    String    @default("#FFFFFF") @db.VarChar(20)
  text_color          String    @default("#333333") @db.VarChar(20)
  button_color        String    @default("#5818C8") @db.VarChar(20)
  
  // Cronômetro de Escassez
  timer_enabled       Boolean   @default(false)
  timer_minutes       Int       @default(15)
  timer_message       String    @default("Oferta expira em:") @db.VarChar(200)
  timer_color         String    @default("#dc2626") @db.VarChar(20)
  
  // Textos personalizados
  custom_title        String?   @db.VarChar(200)
  custom_description  String?
  custom_button_text  String?   @db.VarChar(100)
  success_message     String?
  
  // Configurações avançadas
  show_logo           Boolean   @default(true)
  show_banner         Boolean   @default(true)
  show_timer          Boolean   @default(false)
  show_stock          Boolean   @default(true)
  allow_quantity      Boolean   @default(true)
  
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("checkout_customizations")
}

model Payment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  customer_id     String?   @db.Uuid
  asaas_payment_id String?  @db.VarChar(100)
  efi_txid        String?   @db.VarChar(100)
  efi_charge_id   String?   @db.VarChar(100)
  billing_type    String    @db.VarChar(20)
  status          String    @db.VarChar(20)
  value           Decimal   @db.Decimal(10, 2)
  net_value       Decimal   @default(0) @db.Decimal(10, 2)
  description     String?
  due_date        DateTime? @db.Date
  payment_date    DateTime? @db.Timestamptz
  invoice_url     String?
  bank_slip_url   String?
  pix_qrcode      String?
  pix_copy_paste  String?
  metadata        Json      @default("{}")
  payment_link_id String?   @db.Uuid
  subscription_id String?   @db.Uuid // Vinculo com assinatura
  has_split       Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_link PaymentLink? @relation(fields: [payment_link_id], references: [id])
  chargebacks  Chargeback[]
  subscription_payments SubscriptionPayment[]
  subscription  Subscription?  @relation("PaymentSubscription", fields: [subscription_id], references: [id])
  splits        PaymentSplit[]

  @@map("payments")
}

// ============================================
// PAYMENT SPLITS - Divisão automática de pagamento
// ============================================

model PaymentSplit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id     String   @db.Uuid
  recipient_id   String   @db.Uuid
  type           String   @db.VarChar(10) // "amount" | "percent"
  amount         Decimal? @db.Decimal(10, 2) // valor fixo em R$ (quando type='amount')
  percent        Decimal? @db.Decimal(5, 2)  // 0-100 (quando type='percent')
  computed_value Decimal? @db.Decimal(10, 2) // valor real creditado no webhook
  status         String   @default("pending") @db.VarChar(20) // pending | credited | reversed
  description    String?
  credited_at    DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  payment   Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  recipient User    @relation("SplitRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([recipient_id])
  @@map("payment_splits")
}

model ProductSplitRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @db.Uuid
  recipient_id String   @db.Uuid
  type         String   @db.VarChar(10) // "amount" | "percent"
  amount       Decimal? @db.Decimal(10, 2)
  percent      Decimal? @db.Decimal(5, 2)
  description  String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @db.Timestamptz

  product   Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  recipient User    @relation("SplitRuleRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_split_rules")
}

model PaymentLink {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @db.Uuid
  product_id           String?   @db.Uuid
  asaas_payment_link_id String?  @db.VarChar(100)
  asaas_link_url       String?
  efi_charge_id        String?   @db.VarChar(100)
  name                 String    @db.VarChar(200)
  description          String?
  amount               Decimal   @db.Decimal(10, 2)
  billing_type         String    @default("UNDEFINED") @db.VarChar(20)
  default_billing_type String    @default("PIX") @db.VarChar(20)
  active               Boolean   @default(true)
  clicks               Int       @default(0)
  payments_count       Int       @default(0)
  total_received       Decimal   @default(0) @db.Decimal(10, 2)
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @db.Timestamptz

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [product_id], references: [id])
  payments Payment[]

  @@map("payment_links")
}

model Transaction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  type             String    @db.VarChar(50)
  amount           Decimal   @db.Decimal(10, 2)
  status           String    @db.VarChar(20)
  description      String?
  asaas_payment_id String?   @db.VarChar(100)
  asaas_transfer_id String?  @db.VarChar(100)
  efi_txid         String?   @db.VarChar(100)
  efi_transfer_id  String?   @db.VarChar(100)
  efi_charge_id    String?   @db.VarChar(100)
  metadata         Json      @default("{}")
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Withdrawal {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  amount           Decimal   @db.Decimal(10, 2)
  status           String    @default("pending") @db.VarChar(20)
  withdrawal_type  String    @default("pix") @db.VarChar(20)
  pix_key          String?   @db.VarChar(100)
  pix_key_type     String?   @db.VarChar(20)
  bank_code        String?   @db.VarChar(10)
  bank_name        String?   @db.VarChar(100)
  agency           String?   @db.VarChar(10)
  account_number   String?   @db.VarChar(20)
  account_digit    String?   @db.VarChar(2)
  account_type     String?   @db.VarChar(20)
  holder_name      String?   @db.VarChar(200)
  holder_document  String?   @db.VarChar(20)
  requested_at     DateTime  @default(now()) @db.Timestamptz
  reviewed_at      DateTime? @db.Timestamptz
  reviewed_by      String?   @db.Uuid
  completed_at     DateTime? @db.Timestamptz
  rejection_reason String?
  admin_notes      String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model ApiKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  api_key      String    @unique @db.VarChar(100)
  name         String?   @db.VarChar(100)
  status       String    @default("active") @db.VarChar(20)
  last_used_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Webhook {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  url             String
  secret          String?   @db.VarChar(100)
  events          Json      @default("[]")
  status          String    @default("active") @db.VarChar(20)
  last_success_at DateTime? @db.Timestamptz
  last_failure_at DateTime? @db.Timestamptz
  failure_count   Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id    String   @db.Uuid
  event_type    String   @db.VarChar(50)
  payload       Json
  response_code Int?
  response_body String?
  success       Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz

  webhook Webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, endpoint])
  @@map("push_subscriptions")
}

model BalanceReserve {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  payment_id      String?   @db.Uuid
  original_amount Decimal   @db.Decimal(10, 2)
  reserve_amount  Decimal   @db.Decimal(10, 2)
  released_amount Decimal   @default(0) @db.Decimal(10, 2)
  status          String    @default("held") @db.VarChar(20)
  release_date    DateTime? @db.Timestamptz
  released_at     DateTime? @db.Timestamptz
  description     String?
  created_at      DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("balance_reserves")
}

model UserVerification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @unique @db.Uuid
  document_type    String    @db.VarChar(20)
  document_front_url String?
  document_back_url  String?
  selfie_url       String?
  full_name        String?   @db.VarChar(200)
  birth_date       DateTime? @db.Date
  document_number  String?   @db.VarChar(20)
  status           String    @default("pending") @db.VarChar(20)
  reviewed_at      DateTime? @db.Timestamptz
  reviewed_by      String?   @db.Uuid
  rejection_reason String?
  admin_notes      String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model UserCustomRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @unique @db.Uuid
  pix_rate       Decimal? @db.Decimal(5, 2)
  card_rate      Decimal? @db.Decimal(5, 2)
  boleto_rate    Decimal? @db.Decimal(5, 2)
  withdrawal_fee Decimal? @db.Decimal(10, 2)
  created_by     String?  @db.Uuid
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_custom_rates")
}

model AdminLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String?  @db.Uuid
  action      String   @db.VarChar(100)
  target_type String?  @db.VarChar(50)
  target_id   String?  @db.Uuid
  details     Json?
  ip_address  String?  @db.VarChar(50)
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("admin_logs")
}

model PlatformSettings {
  id                String   @id @default("default") @db.VarChar(50)
  pix_rate          Decimal  @default(5.99) @db.Decimal(5, 2)
  card_rate         Decimal  @default(5.99) @db.Decimal(5, 2)
  boleto_rate       Decimal  @default(5.99) @db.Decimal(5, 2)
  fixed_fee         Decimal  @default(2.50) @db.Decimal(10, 2)
  installment_fee   Decimal  @default(2.49) @db.Decimal(5, 2)
  reserve_percent   Decimal  @default(0.05) @db.Decimal(5, 4)
  reserve_days      Int      @default(30)
  withdrawal_fee    Decimal  @default(2.00) @db.Decimal(10, 2)
  max_installments  Int      @default(12)
  min_pix_value     Decimal  @default(1.00) @db.Decimal(10, 2)
  min_card_value    Decimal  @default(5.00) @db.Decimal(10, 2)
  updated_by        String?  @db.Uuid
  updated_at        DateTime @default(now()) @db.Timestamptz
  created_at        DateTime @default(now()) @db.Timestamptz

