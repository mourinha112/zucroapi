generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String    @db.VarChar(200)
  email                     String    @unique @db.VarChar(200)
  password_hash             String    @db.VarChar(255)
  person_type               String    @default("PF") @db.VarChar(2) // PF = Pessoa Física, PJ = Pessoa Jurídica
  cpf_cnpj                  String?   @db.VarChar(20)
  phone                     String?   @db.VarChar(20)
  avatar                    String?
  asaas_customer_id         String?   @db.VarChar(100)
  asaas_api_key             String?
  balance                   Decimal   @default(0) @db.Decimal(10, 2)
  reserved_balance          Decimal   @default(0) @db.Decimal(10, 2)
  account_status            String    @default("pending") @db.VarChar(20)
  account_status_reason     String?
  account_reviewed_by       String?   @db.Uuid
  account_reviewed_at       DateTime? @db.Timestamptz
  identity_verified         Boolean   @default(false)
  efi_customer_id           String?   @db.VarChar(100)
  payment_provider          String    @default("efibank") @db.VarChar(20) // efibank, asaas
  verification_status       String    @default("pending") @db.VarChar(20)
  verification_submitted_at DateTime? @db.Timestamptz
  verification_reviewed_at  DateTime? @db.Timestamptz
  verification_reviewed_by  String?   @db.Uuid
  verification_rejection_reason String?
  verification_attempts         Int       @default(0) // Contador de tentativas de verificação (máx 3)
  // Campos de risco
  chargeback_count          Int       @default(0)
  refund_count              Int       @default(0)
  is_risky                  Boolean   @default(false)
  risk_level                String    @default("low") @db.VarChar(20) // low, medium, high
  risk_notes                String?
  blocked_at                DateTime? @db.Timestamptz
  blocked_by                String?   @db.Uuid
  blocked_reason            String?
  created_at                DateTime  @default(now()) @db.Timestamptz
  updated_at                DateTime  @default(now()) @db.Timestamptz

  // Relations
  products           Product[]
  payments           Payment[]
  payment_links      PaymentLink[]
  transactions       Transaction[]
  withdrawals        Withdrawal[]
  api_keys           ApiKey[]
  webhooks           Webhook[]
  push_subscriptions PushSubscription[]
  balance_reserves   BalanceReserve[]
  chargebacks        Chargeback[]
  risky_seller_logs  RiskySellerLog[]
  user_verification  UserVerification?
  custom_rates       UserCustomRate[]
  order_bumps        OrderBump[]
  subscription_plans SubscriptionPlan[]
  subscriptions      Subscription[] // Assinaturas criadas pelo usuário (vendedor)
  customer_subscriptions Subscription[] @relation("CustomerSubscriptions") // Assinaturas onde o usuário é cliente

  @@map("users")
}

model AdminCredential {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(200)
  password_hash String    @db.VarChar(255)
  name          String?   @default("Administrador") @db.VarChar(200)
  role          String    @default("admin") @db.VarChar(50)
  is_active     Boolean   @default(true)
  last_login    DateTime? @db.Timestamptz
  permissions   Json      @default("[]")
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz

  @@map("admin_credentials")
}

model Product {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid
  name                  String    @db.VarChar(200)
  description           String?
  price                 Decimal   @db.Decimal(10, 2)
  image_url             String?
  stock                 Int?
  active                Boolean   @default(true)
  marketplace_enabled   Boolean   @default(false)
  commission_percentage Decimal   @default(30) @db.Decimal(5, 2)
  fee_payer             String    @default("seller") @db.VarChar(10)
  is_subscription       Boolean   @default(false) // Produto é uma assinatura?
  subscription_plan_id  String?   @db.Uuid // Plano de assinatura associado
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @default(now()) @db.Timestamptz

  user                   User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_links          PaymentLink[]
  checkout_customization CheckoutCustomization?
  order_bumps           OrderBump[]             @relation("OrderBumpMainProduct")
  offer_order_bumps     OrderBump[]             @relation("OrderBumpOfferProduct")

  @@map("products")
}

model CheckoutCustomization {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String    @unique @db.Uuid
  
  // Imagens
  logo_url            String?
  banner_url          String?
  background_url      String?
  
  // Cores
  primary_color       String    @default("#5818C8") @db.VarChar(20)
  secondary_color     String    @default("#7B2FF7") @db.VarChar(20)
  background_color    String    @default("#FFFFFF") @db.VarChar(20)
  text_color          String    @default("#333333") @db.VarChar(20)
  button_color        String    @default("#5818C8") @db.VarChar(20)
  
  // Cronômetro de Escassez
  timer_enabled       Boolean   @default(false)
  timer_minutes       Int       @default(15)
  timer_message       String    @default("Oferta expira em:") @db.VarChar(200)
  timer_color         String    @default("#dc2626") @db.VarChar(20)
  
  // Textos personalizados
  custom_title        String?   @db.VarChar(200)
  custom_description  String?
  custom_button_text  String?   @db.VarChar(100)
  success_message     String?
  
  // Configurações avançadas
  show_logo           Boolean   @default(true)
  show_banner         Boolean   @default(true)
  show_timer          Boolean   @default(false)
  show_stock          Boolean   @default(true)
  allow_quantity      Boolean   @default(true)
  
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("checkout_customizations")
}

model Payment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  customer_id     String?   @db.Uuid
  asaas_payment_id String?  @db.VarChar(100)
  efi_txid        String?   @db.VarChar(100)
  efi_charge_id   String?   @db.VarChar(100)
  billing_type    String    @db.VarChar(20)
  status          String    @db.VarChar(20)
  value           Decimal   @db.Decimal(10, 2)
  net_value       Decimal   @default(0) @db.Decimal(10, 2)
  description     String?
  due_date        DateTime? @db.Date
  payment_date    DateTime? @db.Timestamptz
  invoice_url     String?
  bank_slip_url   String?
  pix_qrcode      String?
  pix_copy_paste  String?
  metadata        Json      @default("{}")
  payment_link_id String?   @db.Uuid
  subscription_id String?   @db.Uuid // Vinculo com assinatura
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_link PaymentLink? @relation(fields: [payment_link_id], references: [id])
  chargebacks  Chargeback[]
  subscription_payments SubscriptionPayment[]
  subscription  Subscription?  @relation("PaymentSubscription", fields: [subscription_id], references: [id])

  @@map("payments")
}

model PaymentLink {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @db.Uuid
  product_id           String?   @db.Uuid
  asaas_payment_link_id String?  @db.VarChar(100)
  asaas_link_url       String?
  efi_charge_id        String?   @db.VarChar(100)
  name                 String    @db.VarChar(200)
  description          String?
  amount               Decimal   @db.Decimal(10, 2)
  billing_type         String    @default("UNDEFINED") @db.VarChar(20)
  default_billing_type String    @default("PIX") @db.VarChar(20)
  active               Boolean   @default(true)
  clicks               Int       @default(0)
  payments_count       Int       @default(0)
  total_received       Decimal   @default(0) @db.Decimal(10, 2)
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @db.Timestamptz

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [product_id], references: [id])
  payments Payment[]

  @@map("payment_links")
}

model Transaction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  type             String    @db.VarChar(50)
  amount           Decimal   @db.Decimal(10, 2)
  status           String    @db.VarChar(20)
  description      String?
  asaas_payment_id String?   @db.VarChar(100)
  asaas_transfer_id String?  @db.VarChar(100)
  efi_txid         String?   @db.VarChar(100)
  efi_transfer_id  String?   @db.VarChar(100)
  efi_charge_id    String?   @db.VarChar(100)
  metadata         Json      @default("{}")
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Withdrawal {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  amount           Decimal   @db.Decimal(10, 2)
  status           String    @default("pending") @db.VarChar(20)
  withdrawal_type  String    @default("pix") @db.VarChar(20)
  pix_key          String?   @db.VarChar(100)
  pix_key_type     String?   @db.VarChar(20)
  bank_code        String?   @db.VarChar(10)
  bank_name        String?   @db.VarChar(100)
  agency           String?   @db.VarChar(10)
  account_number   String?   @db.VarChar(20)
  account_digit    String?   @db.VarChar(2)
  account_type     String?   @db.VarChar(20)
  holder_name      String?   @db.VarChar(200)
  holder_document  String?   @db.VarChar(20)
  requested_at     DateTime  @default(now()) @db.Timestamptz
  reviewed_at      DateTime? @db.Timestamptz
  reviewed_by      String?   @db.Uuid
  completed_at     DateTime? @db.Timestamptz
  rejection_reason String?
  admin_notes      String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model ApiKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  api_key      String    @unique @db.VarChar(100)
  name         String?   @db.VarChar(100)
  status       String    @default("active") @db.VarChar(20)
  last_used_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Webhook {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  url             String
  secret          String?   @db.VarChar(100)
  events          Json      @default("[]")
  status          String    @default("active") @db.VarChar(20)
  last_success_at DateTime? @db.Timestamptz
  last_failure_at DateTime? @db.Timestamptz
  failure_count   Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id    String   @db.Uuid
  event_type    String   @db.VarChar(50)
  payload       Json
  response_code Int?
  response_body String?
  success       Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz

  webhook Webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, endpoint])
  @@map("push_subscriptions")
}

model BalanceReserve {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  payment_id      String?   @db.Uuid
  original_amount Decimal   @db.Decimal(10, 2)
  reserve_amount  Decimal   @db.Decimal(10, 2)
  released_amount Decimal   @default(0) @db.Decimal(10, 2)
  status          String    @default("held") @db.VarChar(20)
  release_date    DateTime? @db.Timestamptz
  released_at     DateTime? @db.Timestamptz
  description     String?
  created_at      DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("balance_reserves")
}

model UserVerification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @unique @db.Uuid
  document_type    String    @db.VarChar(20)
  document_front_url String?
  document_back_url  String?
  selfie_url       String?
  full_name        String?   @db.VarChar(200)
  birth_date       DateTime? @db.Date
  document_number  String?   @db.VarChar(20)
  status           String    @default("pending") @db.VarChar(20)
  reviewed_at      DateTime? @db.Timestamptz
  reviewed_by      String?   @db.Uuid
  rejection_reason String?
  admin_notes      String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model UserCustomRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @unique @db.Uuid
  pix_rate       Decimal? @db.Decimal(5, 2)
  card_rate      Decimal? @db.Decimal(5, 2)
  boleto_rate    Decimal? @db.Decimal(5, 2)
  withdrawal_fee Decimal? @db.Decimal(10, 2)
  created_by     String?  @db.Uuid
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_custom_rates")
}

model AdminLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String?  @db.Uuid
  action      String   @db.VarChar(100)
  target_type String?  @db.VarChar(50)
  target_id   String?  @db.Uuid
  details     Json?
  ip_address  String?  @db.VarChar(50)
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("admin_logs")
}

model PlatformSettings {
  id                String   @id @default("default") @db.VarChar(50)
  pix_rate          Decimal  @default(5.99) @db.Decimal(5, 2)
  card_rate         Decimal  @default(5.99) @db.Decimal(5, 2)
  boleto_rate       Decimal  @default(5.99) @db.Decimal(5, 2)
  fixed_fee         Decimal  @default(2.50) @db.Decimal(10, 2)
  installment_fee   Decimal  @default(2.49) @db.Decimal(5, 2)
  reserve_percent   Decimal  @default(0.05) @db.Decimal(5, 4)
  reserve_days      Int      @default(30)
  withdrawal_fee    Decimal  @default(2.00) @db.Decimal(10, 2)
  max_installments  Int      @default(12)
  min_pix_value     Decimal  @default(1.00) @db.Decimal(10, 2)
  min_card_value    Decimal  @default(5.00) @db.Decimal(10, 2)
  updated_by        String?  @db.Uuid
  updated_at        DateTime @default(now()) @db.Timestamptz
  created_at        DateTime @default(now()) @db.Timestamptz

  @@map("platform_settings")
}

// ============================================
// CHARGEBACKS E SELLERS DE RISCO
// ============================================

model Chargeback {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id      String    @db.Uuid
  user_id         String    @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  reason          String?
  status          String    @default("open") @db.VarChar(20) // open, won, lost, cancelled
  external_id     String?   @db.VarChar(100) // ID do chargeback no gateway
  opened_at       DateTime  @default(now()) @db.Timestamptz
  resolved_at     DateTime? @db.Timestamptz
  resolved_by     String?   @db.Uuid
  admin_notes     String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("chargebacks")
}

model RiskySellerLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  action          String   @db.VarChar(50) // marked_risky, unmarked_risky, blocked, unblocked
  reason          String?
  chargebacks     Int      @default(0)
  refunds         Int      @default(0)
  total_disputed  Decimal  @default(0) @db.Decimal(10, 2)
  marked_by       String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("risky_seller_logs")
}

// ============================================
// ORDERBUMP - Ofertas adicionais no checkout
// ============================================

model OrderBump {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  product_id        String    @db.Uuid // Produto principal (checkout)
  bump_product_id   String    @db.Uuid // Produto que será oferecido como orderbump
  name              String    @db.VarChar(200) // Nome da oferta (ex: "Levar por R$19,90")
  description       String?   // Descrição breve da oferta
  price             Decimal   @db.Decimal(10, 2) // Preço especial do orderbump
  original_price    Decimal?  @db.Decimal(10, 2) // Preço original (para mostrar desconto)
  discount_type     String    @default("percentage") @db.VarChar(20) // percentage, fixed
  discount_value    Decimal   @default(0) @db.Decimal(10, 2)
  show_in_checkout  Boolean   @default(true)
  show_image        Boolean   @default(true)
  position         Int       @default(0) // Posição de exibição (0 = antes do produto, 1+ = depois)
  min_quantity     Int       @default(1) // Quantidade mínima para ativar
  active           Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product        Product   @relation("OrderBumpMainProduct", fields: [product_id], references: [id], onDelete: Cascade)
  bump_product   Product   @relation("OrderBumpOfferProduct", fields: [bump_product_id], references: [id], onDelete: Cascade)

  @@map("order_bumps")
}

// ============================================
// SUBSCRIPTION PLANS - Planos de assinatura
// ============================================

model SubscriptionPlan {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  name              String    @db.VarChar(200)
  description       String?
  interval          String    @default("month") @db.VarChar(20) // week, month, year
  interval_count    Int       @default(1) // A cada X intervalos (ex: a cada 2 meses)
  price             Decimal   @db.Decimal(10, 2)
  trial_days        Int       @default(0) // Dias de teste gratuito
  max_installments  Int       @default(1) // Parcelamento da primeira cobrança
  cancel_at_end     Boolean   @default(true) // Cancela ao final do período se não houver pagamento
  active            Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ============================================
// SUBSCRIPTIONS - Assinaturas ativas
// ============================================

model Subscription {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid // Vendedor (owner da assinatura)
  customer_id           String?   @db.Uuid // Cliente (se tiver cadastro)
  customer_email        String    @db.VarChar(200)
  customer_name         String?   @db.VarChar(200)
  customer_document     String?   @db.VarChar(20)
  subscription_plan_id  String    @db.Uuid
  external_subscription_id String? @db.VarChar(100) // ID da assinatura no gateway (EfiBank/Asaas)
  status                String    @default("active") @db.VarChar(20) // active, paused, cancelled, past_due
  current_period_start  DateTime  @db.Timestamptz
  current_period_end   DateTime  @db.Timestamptz
  next_billing_date    DateTime  @db.Timestamptz
  cancel_at_period_end  Boolean   @default(false)
  cancelled_at         DateTime? @db.Timestamptz
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @db.Timestamptz

  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  customer         User?             @relation("CustomerSubscriptions", fields: [customer_id], references: [id])
  plan             SubscriptionPlan  @relation(fields: [subscription_plan_id], references: [id])
  subscription_subscriptions SubscriptionPayment[]
  payments         Payment[]         @relation("PaymentSubscription")

  @@map("subscriptions")
}

// ============================================
// SUBSCRIPTION PAYMENTS - Cobranças das assinaturas
// ============================================

model SubscriptionPayment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id       String    @db.Uuid
  payment_id            String?   @db.Uuid // Pagamento criado (se houver)
  external_payment_id   String?   @db.VarChar(100) // ID da cobrança no gateway
  amount                Decimal   @db.Decimal(10, 2)
  status                String    @default("pending") @db.VarChar(20) // pending, paid, failed, cancelled
  billing_date          DateTime  @db.Timestamptz
  paid_at              DateTime? @db.Timestamptz
  failure_reason       String?   @db.VarChar(500)
  created_at           DateTime  @default(now()) @db.Timestamptz

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [payment_id], references: [id])

  @@map("subscription_payments")
}
